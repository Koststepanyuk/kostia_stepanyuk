// 'number' + 3 + 3
// Крок 1: 'number' + 3 => 'number3' (конкатенація, 3 → string)
// Крок 2: 'number3' + 3 => 'number33' (знову конкатенація)
// Результат: 'number33'

// null + 3
// Крок 1: null приводиться до 0 при додаванні
// Крок 2: 0 + 3 = 3
// Результат: 3

// 5 && "qwerty"
// Крок 1: 5 — true в логічному сенсі
// Крок 2: оператор && повертає останнє істинне значення => "qwerty"
// Результат: "qwerty"

// +'40' + +'2' + "hillel";
// Крок 1: +'40' => 40 (унарний + перетворює в число)
// Крок 2: +'2' => 2
// Крок 3: 40 + 2 = 42
// Крок 4: 42 + "hillel" => "42hillel" (конкатенація)
// Результат: "42hillel"

// '10' - 5 === 6;
// Крок 1: '10' - 5 => 10 - 5 = 5 ('10' → число)
// Крок 2: 5 === 6 => false
// Результат: false

// true + false
// Крок 1: true => 1, false => 0
// Крок 2: 1 + 0 = 1
// Результат: 1

// '4px' - 3
// Крок 1: '4px' → NaN (неможливо перетворити в число)
// Крок 2: NaN - 3 => NaN
// Результат: NaN

// '4' - 3
// Крок 1: '4' → 4
// Крок 2: 4 - 3 = 1
// Результат: 1

// '6' + 3 ** 0;
// Крок 1: 3 ** 0 = 1 (експоненціація)
// Крок 2: '6' + 1 => '61' (конкатенація)
// Результат: "61"

// 12 / '6'
// Крок 1: '6' → 6
// Крок 2: 12 / 6 = 2
// Результат: 2

// '10' + (5 === 6);
// Крок 1: 5 === 6 => false
// Крок 2: '10' + false => '10false' (конкатенація)
// Результат: "10false"

// null == ''
// Крок 1: null не дорівнює '' навіть по нестрогому порівнянню
// Результат: false

// 3 ** (9 / 3);
// Крок 1: 9 / 3 = 3
// Крок 2: 3 ** 3 = 27
// Результат: 27

// !!'false' == !!'true'
// Крок 1: !!'false' => true (непорожній рядок — truthy)
// Крок 2: !!'true' => true
// Крок 3: true == true => true
// Результат: true

// 0 || '0' && 1
// Крок 1: '0' && 1 => 1 ('0' — truthy)
// Крок 2: 0 || 1 => 1
// Результат: 1

// (+null == false) < 1;
// Крок 1: +null => 0
// Крок 2: 0 == false => true
// Крок 3: true < 1 => 1 < 1 => false
// Результат: false

// false && true || true
// Крок 1: false && true => false
// Крок 2: false || true => true
// Результат: true

// false && (false || true);
// Крок 1: (false || true) => true
// Крок 2: false && true => false
// Результат: false

// (+null == false) < 1 ** 5;
// Крок 1: +null => 0
// Крок 2: 0 == false => true
// Крок 3: 1 ** 5 => 1
// Крок 4: true < 1 => 1 < 1 => false
// Результат: false
