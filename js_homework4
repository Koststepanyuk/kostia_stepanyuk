function checkProbabilityTheory(count) {
  let evenCount = 0;
  let oddCount = 0;

  for (let i = 0; i < count; i++) {
    // Генеруємо випадкове число від 100 до 1000 включно
    const randomNumber = Math.floor(Math.random() * (1000 - 100 + 1)) + 100;

    // Перевіряємо на парність
    if (randomNumber % 2 === 0) {
      evenCount++;
    } else {
      oddCount++;
    }
  }

  // Обчислення відсотків
  const evenPercent = (evenCount / count) * 100;
  const oddPercent = (oddCount / count) * 100;

  // Вивід результатів
  console.log("Кількість згенерованих чисел:", count);
  console.log("Парних чисел:", evenCount);
  console.log("Непарних чисел:", oddCount);
  console.log("Відсоток парних чисел:", evenPercent.toFixed(2) + "%");
  console.log("Відсоток непарних чисел:", oddPercent.toFixed(2) + "%");
}

// Приклад виклику:
checkProbabilityTheory(1000);
